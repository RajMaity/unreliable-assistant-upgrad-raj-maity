# Copy to .env in the project root (.env is git-ignored). Real environment variables override this file.
LLM_BACKEND=api                              # api (OpenRouter) | mock (offline, deterministic)
OPENROUTER_API_KEY=                          # your own key from openrouter.ai
OPENROUTER_MODEL=anthropic/claude-haiku-4.5  # tested: claude-haiku-4.5, claude-haiku-5.5
LOOP_BUDGET_MS=450                           # design ADR-004 default; see docs/ADR_PENDING.md
